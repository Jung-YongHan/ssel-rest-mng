# ============================================================
#  ssel-rest-mng 환경설정 예시
#  이 파일을 .env 로 복사해서 값을 채우세요.  (.env 는 커밋되지 않습니다)
#      cp .env.example .env
# ============================================================

# ── 앱 ────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── 데이터베이스 ──────────────────────────────────────────────
# 비워두면 backend/data/app.db (SQLite) 를 자동 사용합니다.
# PostgreSQL 로 옮길 때: postgresql+psycopg://user:pw@host:5432/dbname
DATABASE_URL=

# ── 인증 ──────────────────────────────────────────────────────
# 운영 배포 전 반드시 교체하세요:  openssl rand -hex 32
JWT_SECRET=change-me-please-openssl-rand-hex-32
# 로그인 유지 기간 (분).  기본 30일
JWT_EXPIRE_MINUTES=43200
# HTTPS 로 서비스할 때만 true (HTTP 배포 시 true 로 두면 로그인이 안 됩니다)
COOKIE_SECURE=false

# 회원가입에 필요한 초대코드 — 연구실 구성원에게만 공유
INVITE_CODE=change-me-invite-code

# 최초 관리자 계정 (scripts/seed.py 실행 시 생성)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=관리자

# ── 영수증 OCR (자체 호스팅 Qwen 서버) ────────────────────────
# ⚠️  내부 IP/엔드포인트는 이 .env 에만 적고 코드·문서에 하드코딩하지 마세요.
#
# OCR_PROVIDER 옵션:
#   qwen_vl      : Qwen 비전 모델에 이미지를 직접 전송 (기본, 권장)
#   qwen_text    : PaddleOCR 로 텍스트 추출 후 Qwen(텍스트)이 JSON 구조화 (비전 미지원 시)
#   disabled     : OCR 끄기 — 앱은 전부 수동 입력으로 동작
OCR_PROVIDER=qwen_vl

# OpenAI 호환 베이스 URL (vLLM 등).  예: http://10.0.0.5:8000/v1
OCR_BASE_URL=
OCR_MODEL=Qwen3.6-27B
# 서버가 API 키를 요구하지 않으면 비워두세요
OCR_API_KEY=
OCR_TIMEOUT=120
# 전송 전 이미지 긴 변을 이 픽셀로 축소 (속도/정확도 균형)
OCR_MAX_IMAGE_PX=1600
# vLLM guided_json(구조화 출력) 지원 서버면 true
OCR_USE_GUIDED_JSON=false

# ── 업로드 ────────────────────────────────────────────────────
MAX_UPLOAD_MB=15

# ── 화면 표시 ─────────────────────────────────────────────────
# 잔액이 이 금액 미만이면 목록에 "잔액 부족" 경고 배지 표시 (원)
LOW_BALANCE_THRESHOLD=30000

# ── 개발용 CORS (Vite 프록시를 쓰면 비워두세요) ───────────────
CORS_ORIGINS=
